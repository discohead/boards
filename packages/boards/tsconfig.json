{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "lib": [
      "es2024"
    ],
    "types": [
      "@cloudflare/workers-types",
      "node"
    ],
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}
