{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The app: Start, and in time the seats, sessions, and apps (design/workbus.md §10.1).
  "name": "workbus-app",
  "main": "src/server.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  // workbus.dev is behind Access: nothing of the app is served anywhere else.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "workbus.dev", "custom_domain": true }],
  "vars": {
    "ACCESS_TEAM": "dry-hat-4b71",
    "ACCESS_AUD": "542ecc9a8a6c7697f75072ec34267695839de8ceb7e7a7d0d02e4126c94e97bb"
  },
  // The bus, as the Worker workbus-app: the binding is the credential.
  "services": [
    { "binding": "WORKBUS", "service": "workbus-bus", "entrypoint": "Workbus", "props": { "principal": "workbus-app" } },
    // The bus's HTTP face, for reads as the person: a route loader forwards their Access assertion.
    { "binding": "BUS", "service": "workbus-bus" }
  ],
  // Seats' models, through the org's AI Gateway "workbus" (its provider keys are on the gateway).
  "ai": { "binding": "AI", "remote": true },
  // A computer workspace's exec runs in Dynamic Workers minted through this, with no network.
  "worker_loaders": [{ "binding": "LOADER" }],
  // The seats' runtime (design/workbus.md §5.2): a Seat per seat key, a Session per seat and thread.
  "durable_objects": {
    "bindings": [
      { "name": "SEAT", "class_name": "Seat" },
      { "name": "SESSION", "class_name": "Session" },
      // A seat's computer workspace, shared by its sessions: one per seat key.
      { "name": "WORKSPACE", "class_name": "SeatWorkspace" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Seat", "Session", "SeatWorkspace"] }],
  // The web tier's fallback reader (src/harness/web.ts): Browser Run's markdown, for pages a plain fetch can't read.
  "browser": { "binding": "BROWSER", "remote": true },
  // The "Workbus" GitHub App's id and key, which only the egress reads (src/egress/github.ts).
  "secrets_store_secrets": [
    { "binding": "GITHUB_APP_ID", "store_id": "325a978922414509877e38091676ce6c", "secret_name": "WORKBUS_GITHUB_APP_ID" },
    { "binding": "GITHUB_APP_KEY", "store_id": "325a978922414509877e38091676ce6c", "secret_name": "WORKBUS_GITHUB_APP_KEY" }
  ],
  // Run records (src/telemetry/): the stream runs_v1, into the Iceberg table telemetry.runs_v1 in the
  // bucket workbus-telemetry (design/workbus.md §8.1). Its schema is src/telemetry/runs_v1.schema.json.
  "pipelines": [{ "stream": "9f6075496bea44d488f44b0ee429d5f0", "binding": "RUNS" }],
  "observability": { "enabled": true },
  "upload_source_maps": true
}
