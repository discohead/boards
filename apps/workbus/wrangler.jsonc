{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The app: Start, and in time the seats, sessions, and apps (design/workbus.md §10.1).
  "name": "workbus-app",
  "main": "src/server.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  // workbus.dev is behind Access: nothing of the app is served anywhere else.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "workbus.dev", "custom_domain": true }],
  "vars": {
    "ACCESS_TEAM": "dry-hat-4b71",
    "ACCESS_AUD": "542ecc9a8a6c7697f75072ec34267695839de8ceb7e7a7d0d02e4126c94e97bb"
  },
  // The bus, as the Worker workbus-app: the binding is the credential.
  "services": [
    { "binding": "WORKBUS", "service": "workbus-bus", "entrypoint": "Workbus", "props": { "principal": "workbus-app" } },
    // The bus's HTTP face, for reads as the person: a route loader forwards their Access assertion.
    { "binding": "BUS", "service": "workbus-bus" }
  ],
  // Seats' models, through the org's AI Gateway "workbus" (its provider keys are on the gateway).
  "ai": { "binding": "AI", "remote": true },
  // A computer workspace's exec runs in Dynamic Workers minted through this, with no network.
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": {
    "bindings": [{ "name": "SESSION", "class_name": "Session" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session"] }],
  "observability": { "enabled": true },
  "upload_source_maps": true
}
