{
  "name": "workbus-app",
  "private": true,
  "type": "module",
  "description": "The Workbus app at workbus.dev: TanStack Start on Workers (workbus-app), and the bus it reads (workbus-bus, in bus/).",
  "scripts": {
    "dev": "CLOUDFLARE_DEV_REGISTRY_PATH=.wrangler/registry vite dev --port 8831 --strictPort",
    "dev:bus": "CLOUDFLARE_DEV_REGISTRY_PATH=.wrangler/registry wrangler dev -c bus/wrangler.jsonc --port 8832 --inspector-port 9832 --ip 127.0.0.1",
    "build": "vite build",
    "preview": "vite build && vite preview --port 8833",
    "typecheck": "wrangler types -c wrangler.jsonc >/dev/null && tsc --noEmit -p . && tsc --noEmit -p bus",
    "deploy": "vite build && wrangler deploy",
    "deploy:bus": "wrangler deploy -c bus/wrangler.jsonc",
    "cf-typegen": "wrangler types -c wrangler.jsonc"
  },
  "dependencies": {
    "@tanstack/db": "1.0.0-rc.1.5",
    "@tanstack/highlight": "1.2.12",
    "@tanstack/markdown": "1.2.1",
    "@tanstack/react-db": "1.0.0-rc.1.5",
    "@tanstack/react-hotkeys": "0.27.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "@tanstack/react-virtual": "3.14.26",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "jose": "^6.2.18",
    "lucide-react": "^1.77.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "workbus": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261120.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "4.165.0"
  }
}
