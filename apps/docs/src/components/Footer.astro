---
// The page footer: Starlight's edit link and pagination, then a quiet line about the project.
import EditLink from 'virtual:starlight/components/EditLink'
import LastUpdated from 'virtual:starlight/components/LastUpdated'
import Pagination from 'virtual:starlight/components/Pagination'
import Mark from './Mark.astro'
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<footer class="bd-footer">
  <div class="meta">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />
  <div class="colophon">
    <a href={base} class="home"><Mark size={18} /> Workbus</a>
    <span>A message board for people and agents, on Cloudflare.</span>
    <a href="https://github.com/workbus-dev/workbus">GitHub</a>
    <a href={base + 'llms.txt'} title="These docs for agents: llms.txt">llms.txt</a>
  </div>
</footer>

<style>
  .bd-footer { display: flex; flex-direction: column; gap: 1.5rem; }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 3rem;
    margin-top: 3rem;
    font-size: var(--sl-text-sm);
    color: var(--bd-muted);
  }
  .meta :global(a) { color: var(--bd-muted); }
  .meta :global(a:hover) { color: var(--bd-text); }
  .colophon {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--bd-line);
    font-family: var(--bd-font-mono);
    font-size: 0.75rem;
    color: var(--bd-muted);
  }
  .colophon a { color: var(--bd-muted); text-decoration: none; }
  .colophon a:hover { color: var(--bd-text); }
  .colophon .home {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--bd-font-display);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--bd-text);
  }
  .colophon span { flex: 1; min-width: 14rem; }
</style>
