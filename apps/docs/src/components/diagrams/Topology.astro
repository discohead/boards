---
// The pieces of a board on Cloudflare and how they connect.
import Diagram from './Diagram.astro'
interface Props { caption?: string }
const { caption = "The Gateway authenticates every call; one Ledger per board writes it and keeps its log; Relays, Mailboxes, and Inboxes do the work around it, and R2 holds files and history." } = Astro.props
---

<Diagram caption={caption} minWidth={560}>
  <svg viewBox="0 0 720 592" role="img" aria-labelledby="topo-title topo-desc" xmlns="http://www.w3.org/2000/svg">
    <title id="topo-title">Workbus topology</title>
    <desc id="topo-desc">People, agents, programs, and Workers call the Gateway, a stateless Worker that authenticates them over HTTP, SSE, MCP, Cap'n Web, or the Workbus entrypoint. The Gateway calls the board's Ledger, a Durable Object holding one log. The Ledger rings Relays, which hold live tails and waits for the Gateway, and hands matches to Mailboxes, which deliver to watchers and, as each sync's courier, copy board writes to GitHub, Slack, Linear, and Notion. Platform webhooks reach the Gateway, are kept in an Inbox, and are imported into the Ledger in order. The Ledger keeps files and archived history in R2.</desc>
    <defs>
      <marker id="topo-a" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="head" d="M0,1 L9,5 L0,9 z" /></marker>
      <marker id="topo-aa" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="head accent" d="M0,1 L9,5 L0,9 z" /></marker>
      <marker id="topo-av" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="head violet" d="M0,1 L9,5 L0,9 z" /></marker>
      <marker id="topo-as" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="head sky" d="M0,1 L9,5 L0,9 z" /></marker>
      <marker id="topo-ar" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="head rose" d="M0,1 L9,5 L0,9 z" /></marker>
    </defs>

    <rect class="n " x="16" y="20" width="158" height="66" rx="12" />
    <text class="t" x="32" y="47">People</text>
    <text class="s" x="32" y="68">CLI · browser</text>
    <path class="e" d="M95,86 V125" marker-end="url(#topo-a)" />
    <rect class="n " x="190" y="20" width="158" height="66" rx="12" />
    <text class="t" x="206" y="47">Agents</text>
    <text class="s" x="206" y="68">MCP · run_code</text>
    <path class="e" d="M269,86 V125" marker-end="url(#topo-a)" />
    <rect class="n " x="364" y="20" width="158" height="66" rx="12" />
    <text class="t" x="380" y="47">Programs</text>
    <text class="s" x="380" y="68">Cap'n Web</text>
    <path class="e" d="M443,86 V125" marker-end="url(#topo-a)" />
    <rect class="n " x="538" y="20" width="158" height="66" rx="12" />
    <text class="t" x="554" y="47">Workers</text>
    <text class="s" x="554" y="68">service binding</text>
    <path class="e" d="M617,86 V125" marker-end="url(#topo-a)" />

    <rect class="n violet" x="16" y="128" width="688" height="86" rx="12" />
    <text class="t lg" x="36" y="162">Gateway</text>
    <text class="s" x="36" y="184">a stateless Worker</text>
    <text class="s" x="36" y="201">authenticates every call</text>
    <rect class="chip" x="270" y="158" width="72" height="26" rx="6" /><text class="s ink" x="306" y="175.5" text-anchor="middle">HTTP v1</text><rect class="chip" x="350" y="158" width="48" height="26" rx="6" /><text class="s ink" x="374" y="175.5" text-anchor="middle">SSE</text><rect class="chip" x="406" y="158" width="48" height="26" rx="6" /><text class="s ink" x="430" y="175.5" text-anchor="middle">MCP</text><rect class="chip" x="462" y="158" width="88" height="26" rx="6" /><text class="s ink" x="506" y="175.5" text-anchor="middle">Cap'n Web</text><rect class="chip" x="558" y="158" width="136" height="26" rx="6" /><text class="s ink" x="626" y="175.5" text-anchor="middle">Workbus entrypoint</text>

    <rect class="n sky" x="16" y="270" width="160" height="88" rx="12" />
    <text class="t" x="32" y="298">Relays</text>
    <text class="s" x="32" y="320">live tails</text>
    <text class="s" x="32" y="338">held waits</text>
    <path class="e sky" d="M96,217 V267" marker-start="url(#topo-as)" marker-end="url(#topo-as)" />
    <text class="lbl" x="104" y="246">waits</text>

    <rect class="n accent" x="226" y="270" width="268" height="178" rx="12" />
    <text class="t lg" x="246" y="302">Ledger</text>
    <text class="s ink" x="246" y="324">a Durable Object per board</text>
    <rect class="cell" x="246" y="338" width="19" height="22" rx="4" /><rect class="cell" x="269" y="338" width="19" height="22" rx="4" /><rect class="cell" x="292" y="338" width="19" height="22" rx="4" /><rect class="cell" x="315" y="338" width="19" height="22" rx="4" /><rect class="cell" x="338" y="338" width="19" height="22" rx="4" /><rect class="cell" x="361" y="338" width="19" height="22" rx="4" /><rect class="cell" x="384" y="338" width="19" height="22" rx="4" /><rect class="cell" x="407" y="338" width="19" height="22" rx="4" /><rect class="cell" x="430" y="338" width="19" height="22" rx="4" /><rect class="cell new pulse" x="453" y="338" width="19" height="22" rx="4" />
    <text class="s" x="246" y="390">one log, gapless seq</text>
    <text class="s" x="246" y="410">one transaction per write</text>
    <text class="s" x="246" y="430">one alarm for every timer</text>
    <path class="e accent flow" d="M360,214 V267" marker-end="url(#topo-aa)" />
    <text class="lbl accent" x="368" y="246">calls</text>
    <path class="e sky" d="M226,314 H179" marker-end="url(#topo-as)" />
    <text class="lbl" x="188" y="306">ring</text>

    <rect class="n violet" x="544" y="270" width="160" height="88" rx="12" />
    <text class="t" x="560" y="298">Inboxes</text>
    <text class="s" x="560" y="320">one per sync key</text>
    <text class="s" x="560" y="338">kept before 200</text>
    <path class="e violet" d="M624,214 V267" marker-end="url(#topo-av)" />
    <text class="lbl" x="616" y="246" text-anchor="end">verified</text>
    <path class="e violet" d="M544,314 H497" marker-end="url(#topo-av)" />
    <text class="lbl" x="500" y="306">import</text>

    <rect class="n yellow" x="16" y="380" width="160" height="108" rx="12" />
    <text class="t" x="32" y="406">R2</text>
    <text class="s" x="32" y="426">files</text>
    <text class="s" x="32" y="442">sealed segments</text>
    <text class="s" x="32" y="458">cold threads</text>
    <text class="s" x="32" y="474">frozen pages</text>
    <path class="e" d="M226,420 H179" marker-end="url(#topo-a)" />

    <rect class="n violet" x="544" y="380" width="160" height="88" rx="12" />
    <text class="t" x="560" y="408">Mailboxes</text>
    <text class="s" x="560" y="430">watchers, courier</text>
    <text class="s" x="560" y="448">5 tries, in order</text>
    <path class="e violet" d="M494,420 H541" marker-end="url(#topo-av)" />
    <text class="lbl" x="498" y="412">match</text>

    <rect class="n " x="226" y="512" width="478" height="64" rx="12" />
    <text class="t" x="246" y="550">Platforms</text>
    <rect class="chip" x="364" y="531" width="76" height="26" rx="6" /><text class="s ink" x="402" y="548.5" text-anchor="middle">GitHub</text><rect class="chip" x="448" y="531" width="76" height="26" rx="6" /><text class="s ink" x="486" y="548.5" text-anchor="middle">Slack</text><rect class="chip" x="532" y="531" width="76" height="26" rx="6" /><text class="s ink" x="570" y="548.5" text-anchor="middle">Linear</text><rect class="chip" x="616" y="531" width="76" height="26" rx="6" /><text class="s ink" x="654" y="548.5" text-anchor="middle">Notion</text>
    <path class="e violet" d="M624,468 V509" marker-end="url(#topo-av)" />
    <text class="lbl" x="616" y="494" text-anchor="end">courier</text>
    <path class="e" d="M704,544 H713 V172 H707" marker-end="url(#topo-a)" />
    <text class="lbl" x="708" y="250" text-anchor="end">webhooks</text>
  </svg>
</Diagram>
