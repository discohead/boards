---
// Where a board's history lives as it ages: hot in the Ledger, then sealed, cold, and frozen in R2.
import Diagram from './Diagram.astro'
interface Props { caption?: string }
const { caption = "History moves to R2 in bounded steps under the alarm, and a read that needs it faults it back: every answer stays the same. The ages are the defaults." } = Astro.props
---

<Diagram caption={caption} minWidth={560}>
  <svg viewBox="0 0 720 506" role="img" aria-labelledby="arch-title arch-desc" xmlns="http://www.w3.org/2000/svg">
    <title id="arch-title">Archival tiers</title>
    <desc id="arch-desc">Hot, in the Ledger's SQLite: the log's last 30 days and at least its newest 1,000 events, and threads active in the last 90 days or holding an open task, a pending schedule, sync, or a match a watcher has yet to take. Log events past 30 days are sealed into R2 segments of 1,000 events, gzipped. Threads quiet for 90 days go cold: their messages move to one R2 object per thread, and their listing rows and what filters match on stay hot. Threads cold for 30 more days are frozen into R2 pages of 256 threads, and only a Bloom filter per page stays hot.</desc>
    <defs>
      <marker id="arch-a" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="head" d="M0,1 L9,5 L0,9 z" /></marker>
      <marker id="arch-aa" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="head accent" d="M0,1 L9,5 L0,9 z" /></marker>
      <marker id="arch-av" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="head violet" d="M0,1 L9,5 L0,9 z" /></marker>
      <marker id="arch-as" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="head sky" d="M0,1 L9,5 L0,9 z" /></marker>
      <marker id="arch-ar" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="head rose" d="M0,1 L9,5 L0,9 z" /></marker>
    </defs>

    <rect class="n accent" x="16" y="16" width="688" height="140" rx="16" />
    <text class="zt accent" x="36" y="44">Hot · the Ledger's SQLite</text>
    <rect class="n " x="32" y="58" width="316" height="82" rx="12" />
    <text class="t" x="50" y="86">The log</text>
    <text class="s ink" x="50" y="108">the last 30 days, and at least</text>
    <text class="s" x="50" y="125">the newest 1,000 events</text>
    <rect class="n " x="372" y="58" width="316" height="82" rx="12" />
    <text class="t" x="390" y="86">Threads</text>
    <text class="s ink" x="390" y="108">active in 90 days, or with an</text>
    <text class="s" x="390" y="125">open task, schedule, or sync</text>

    <rect class="n yellow" x="16" y="200" width="688" height="290" rx="16" />
    <text class="zt" x="36" y="228">R2</text>
    <rect class="n " x="32" y="242" width="316" height="110" rx="12" />
    <text class="t" x="50" y="270">Sealed segments</text>
    <text class="s ink" x="50" y="292">1,000 events each, gzipped</text>
    <text class="s" x="50" y="309">boards/&lt;board&gt;/segments/</text>
    <text class="s" x="50" y="326">&lt;first&gt;-&lt;last&gt;</text>
    <text class="s" x="50" y="343">read back for the feed</text>
    <rect class="n " x="372" y="242" width="316" height="110" rx="12" />
    <text class="t" x="390" y="270">Cold threads</text>
    <text class="s ink" x="390" y="292">messages, an object a thread</text>
    <text class="s" x="390" y="309">boards/&lt;board&gt;/threads/&lt;root&gt;</text>
    <text class="s" x="390" y="326">stays hot: its listing row</text>
    <text class="s" x="390" y="343">and what filters match on</text>
    <rect class="n " x="372" y="392" width="316" height="82" rx="12" />
    <text class="t" x="390" y="420">Frozen pages</text>
    <text class="s ink" x="390" y="442">summaries, 256 threads a page</text>
    <text class="s" x="390" y="459">stays hot: a Bloom filter</text>

    <path class="e" d="M190,141 V239" marker-end="url(#arch-a)" />
    <text class="lbl" x="198" y="186">sealed past 30 days</text>
    <path class="e" d="M530,141 V239" marker-end="url(#arch-a)" />
    <text class="lbl" x="538" y="186">quiet 90 days</text>
    <path class="e" d="M530,353 V389" marker-end="url(#arch-a)" />
    <text class="s" x="538" y="376">30 days later</text>
  </svg>
</Diagram>
