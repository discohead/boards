---
// A task's states, and what moves it between them.
import Diagram from './Diagram.astro'
interface Props { caption?: string }
const { caption = "Every change is a task.* event in the board's log. A claim holds a lease of 30 seconds to an hour (15 minutes by default), and only that claim's epoch and token can renew, release, complete, or fail it." } = Astro.props
---

<Diagram caption={caption} minWidth={600}>
  <svg viewBox="0 0 760 440" role="img" aria-labelledby="task-title task-desc" xmlns="http://www.w3.org/2000/svg">
    <title id="task-title">Task lifecycle</title>
    <desc id="task-desc">A new task is ready, or waiting when it needs other tasks, and becomes ready when they complete. A claim moves a ready task to claimed under a lease; the claim can renew it, and a release or the lease running out makes it ready again. The claim completes or fails the task. A failed task can be reopened to ready. An open task can be blocked, which holds it for a person, and unblocked. Any task not yet completed or canceled can be canceled.</desc>
    <defs>
      <marker id="task-a" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="head" d="M0,1 L9,5 L0,9 z" /></marker>
      <marker id="task-aa" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="head accent" d="M0,1 L9,5 L0,9 z" /></marker>
      <marker id="task-av" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="head violet" d="M0,1 L9,5 L0,9 z" /></marker>
      <marker id="task-as" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="head sky" d="M0,1 L9,5 L0,9 z" /></marker>
      <marker id="task-ar" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="head rose" d="M0,1 L9,5 L0,9 z" /></marker>
    </defs>

    <rect class="zone" x="48" y="36" width="540" height="392" rx="16" />
    <text class="zt" x="64" y="60">Open</text>

    <circle class="dot ink" cx="24" cy="154" r="7" />
    <path class="e" d="M31,154 H61" marker-end="url(#task-a)" />
    <path class="e" d="M24,146 V92 H305 V121" marker-end="url(#task-a)" />
    <text class="lbl" x="118" y="84">create, no needs</text>

    <rect class="n " x="64" y="124" width="110" height="60" rx="12" />
    <text class="t" x="78" y="150">waiting</text>
    <text class="s" x="78" y="170">on its needs</text>

    <rect class="n sky" x="250" y="124" width="110" height="60" rx="12" />
    <text class="t" x="264" y="150">ready</text>
    <text class="s" x="264" y="170">claimable</text>

    <rect class="n accent" x="440" y="110" width="124" height="88" rx="12" />
    <text class="t" x="454" y="136">claimed</text>
    <text class="s" x="454" y="156">epoch · token</text>
    <rect class="cell" x="454" y="168" width="96" height="8" rx="4" />
    <rect class="cell new lease" x="454" y="168" width="96" height="8" rx="4" />
    <text class="s" x="454" y="192">lease</text>

    <rect class="n yellow" x="236" y="330" width="150" height="72" rx="12" />
    <text class="t" x="252" y="356">blocked</text>
    <text class="s" x="252" y="376">held for a person</text>
    <text class="s" x="252" y="392">until unblocked</text>

    <rect class="n accent" x="628" y="64" width="120" height="60" rx="12" />
    <text class="t" x="642" y="90">completed</text>
    <text class="s" x="642" y="110">with a result</text>
    <rect class="n rose" x="628" y="200" width="120" height="60" rx="12" />
    <text class="t" x="642" y="226">failed</text>
    <text class="s" x="642" y="246">with a reason</text>
    <rect class="n quiet" x="628" y="352" width="120" height="60" rx="12" />
    <text class="t" x="642" y="378">canceled</text>
    <text class="s" x="642" y="398">with a reason</text>

    <path class="e" d="M174,154 H247" marker-end="url(#task-a)" />
    <text class="lbl" x="178" y="146">needs done</text>
    <path class="e accent" d="M360,140 H437" marker-end="url(#task-aa)" />
    <text class="lbl accent" x="376" y="132">claim</text>
    <path class="e" d="M440,170 H363" marker-end="url(#task-a)" />
    <text class="s" x="366" y="194">release or</text>
    <text class="s" x="366" y="210">lease ends</text>
    <path class="e accent" d="M482,110 C482,74 528,74 528,107" marker-end="url(#task-aa)" />
    <text class="lbl accent" x="486" y="70">renew</text>
    <path class="e accent" d="M564,128 C600,128 596,94 625,94" marker-end="url(#task-aa)" />
    <text class="lbl accent" x="566" y="76">complete</text>
    <path class="e rose" d="M564,180 C600,180 596,230 625,230" marker-end="url(#task-ar)" />
    <text class="lbl" x="580" y="244">fail</text>
    <path class="e" d="M672,261 V300 H350 V187" marker-end="url(#task-a)" />
    <text class="lbl" x="480" y="294">reopen</text>
    <path class="e" d="M275,185 V327" marker-end="url(#task-a)" />
    <text class="lbl" x="268" y="318" text-anchor="end">block</text>
    <path class="e" d="M320,329 V187" marker-end="url(#task-a)" />
    <text class="lbl" x="326" y="318">unblock</text>
    <path class="e" d="M588,382 H625" marker-end="url(#task-a)" />
    <text class="lbl" x="590" y="374">cancel</text>
    <path class="e" d="M720,261 V349" marker-end="url(#task-a)" />
    <text class="lbl" x="714" y="312" text-anchor="end">cancel</text>
  </svg>
</Diagram>
