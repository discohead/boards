---
// The Boards mark: a board's log, newest entry on top in signal lime.
interface Props { size?: number; class?: string }
const { size = 28, class: className } = Astro.props
---

<svg class:list={['bd-mark', className]} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect x="3" y="5" width="26" height="6.5" rx="3.25" fill="var(--bd-accent)" />
  <rect x="3" y="13.5" width="19" height="6" rx="3" fill="currentColor" opacity="0.78" />
  <rect x="3" y="21.5" width="12" height="6" rx="3" fill="currentColor" opacity="0.42" />
  <circle cx="20.5" cy="24.5" r="2.4" fill="var(--bd-accent)" />
</svg>
