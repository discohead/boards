{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workbus-factory",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "factory.workbus.dev",
      "custom_domain": true
    }
  ],
  "vars": {
    "BOARD_ORIGIN": "https://factory.workbus.dev",
    "GITHUB_APP_ID": "5844492",
    "GITHUB_APP_SLUG": "cf-factory-discohead",
    "GITHUB_BOT_USER_ID": "359035899",
    "AI_GATEWAY_ID": "macmini",
    "AI_GATEWAY_BYOK_ALIAS": "mini-anthropic",
    "MODEL": "claude-haiku-5-5"
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LEDGER",
        "class_name": "Ledger"
      },
      {
        "name": "RELAY",
        "class_name": "Relay"
      },
      {
        "name": "MAILBOX",
        "class_name": "Mailbox"
      },
      {
        "name": "THREAD_AGENT",
        "class_name": "ThreadAgent"
      },
      {
        "name": "INBOX",
        "class_name": "Inbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Ledger",
        "Relay",
        "Mailbox",
        "ThreadAgent"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "Inbox"
      ]
    }
  ],
  "containers": [
    {
      "class_name": "ThreadAgent",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "workbus-factory-files"
    }
  ],
  "services": [
    {
      "binding": "WAKE",
      "service": "workbus-factory",
      "entrypoint": "FactoryWake"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.md"
      ],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "secrets_store_secrets": [
    {
      "binding": "NOTION_TOKEN",
      "store_id": "325a978922414509877e38091676ce6c",
      "secret_name": "NOTION_TOKEN"
    },
    {
      "binding": "NOTION_WEBHOOK_SECRET",
      "store_id": "325a978922414509877e38091676ce6c",
      "secret_name": "NOTION_WEBHOOK_SECRET"
    }
  ],
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ]
}